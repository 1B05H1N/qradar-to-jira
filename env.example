# === REQUIRED VARIABLES ===
# QRadar Configuration
QRADAR_URL=https://your-qradar-instance/api/siem/offenses
QRADAR_TOKEN=your-qradar-sec-token  # Get from QRadar Admin > Manage Authorized Services
QRADAR_OFFENSE_STATUS=OPEN  # Status of offenses to process (e.g., OPEN, CLOSED, HIDDEN)
QRADAR_SEVERITY_MIN=1  # Minimum severity to process (1-10)
QRADAR_SEVERITY_MAX=10  # Maximum severity to process (1-10)

# Jira Configuration
JIRA_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your-email@domain.com
JIRA_API_TOKEN=your-jira-api-token  # Get from Atlassian Account > Security > API tokens
PROJECT_KEY=YOUR_PROJECT_KEY  # The key of your Jira project (e.g., SEC, SECOPS)
JIRA_ISSUE_TYPE=Task  # Type of issue to create (e.g., Task, Bug, Story)
JIRA_ASSIGNEE=your-username  # Default assignee for created issues
JIRA_COMPONENTS=Security,Monitoring  # Comma-separated list of components
JIRA_LABELS=QRadar,SIEM,Security  # Comma-separated list of labels

# === OPTIONAL VARIABLES ===
# Logging Configuration
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
MAX_LOG_SIZE=10  # Maximum log file size in MB
BACKUP_COUNT=5  # Number of backup log files to keep
LOG_FILE=/var/log/qradar_to_jira/qradar_to_jira.log  # Custom log file path

# SSL Configuration
SSL_VERIFY=true  # Set to false only for testing
SSL_CERT_PATH=/path/to/your/cert.pem  # Path to custom SSL certificate
SSL_SECURITY_LEVEL=high  # high, medium, low
SSL_CIPHERS=HIGH:!aNULL:!MD5  # Custom SSL ciphers (if needed)

# Error Handling
MAX_RETRIES=3  # Maximum number of retry attempts
RETRY_DELAY=5  # Delay between retries in seconds
CHECKPOINT_FILE=.checkpoint  # File to track last processed offense
ERROR_NOTIFICATION_EMAIL=admin@your-domain.com  # Email for error notifications

# Test Mode
TEST_MODE=false  # Set to true for testing (won't create actual Jira issues)
TEST_OFFENSE_LIMIT=1  # Number of offenses to process in test mode

# Integration Settings
SYNC_INTERVAL=15  # Minutes between syncs (for cron job)
OFFENSE_AGE_DAYS=30  # Only process offenses newer than this
INCLUDE_CLOSED_OFFENSES=false  # Whether to process closed offenses
CREATE_DUPLICATE_COMMENTS=true  # Add comments for duplicate offenses

# Custom Field Mapping
JIRA_CUSTOM_FIELD_QRADAR_ID=customfield_10000  # QRadar ID field
JIRA_CUSTOM_FIELD_SEVERITY=customfield_10001  # Severity field
JIRA_CUSTOM_FIELD_SOURCE_IP=customfield_10002  # Source IP field
JIRA_CUSTOM_FIELD_DESTINATION_IP=customfield_10003  # Destination IP field

# Priority Mapping
PRIORITY_MAPPING_1=Highest  # QRadar severity 1-2
PRIORITY_MAPPING_2=High     # QRadar severity 3-4
PRIORITY_MAPPING_3=Medium   # QRadar severity 5-6
PRIORITY_MAPPING_4=Low      # QRadar severity 7-8
PRIORITY_MAPPING_5=Lowest   # QRadar severity 9-10

# === NOTES ===
# 1. Never commit the actual .env file to version control
# 2. Keep this file as env.example and copy it to .env
# 3. Fill in your actual values in the .env file
# 4. Set appropriate file permissions: chmod 600 .env
# 5. Store API tokens securely and rotate them regularly
# 6. Adjust values based on your environment and requirements
# 7. Test configuration changes in test mode first 